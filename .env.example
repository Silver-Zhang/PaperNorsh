# ============================================================
# PaperNosh — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----- Security ------------------------------------------
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-secret-key-please-change-in-production

# ----- Database ------------------------------------------
DATABASE_URL=postgresql://papernosh:papernosh@localhost:5432/papernosh

# ----- Redis ---------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- Email (optional for MVP — digests visible on web) --
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@papernosh.io

# ----- AI Summaries (optional) ---------------------------
# If left empty, the system gracefully falls back to truncated abstracts.
OPENAI_API_KEY=

# ----- App -----------------------------------------------
ENVIRONMENT=development
